{
  "name": "io-technology",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cross-env SOCKET=true node ./scripts/next-remote-watch.js ./data",
    "dev": "next dev",
    "build": "next build && node ./scripts/generate-sitemap && node ./scripts/generate-devto",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "eslint --fix pages components lib layouts scripts",
    "lint-staged": "lint-staged",
    "prepare": "husky install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "update:patch": "npm-check-updates --configFileName .ncurc.patch.cjs",
    "update:minor": "npm-check-updates --configFileName .ncurc.minor.cjs",
    "update:major": "npm-check-updates --configFileName .ncurc.major.cjs"
  },
  "engines": {
    "node": "~22",
    "npm": "~10",
    "yarn": "~1"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@lottiefiles/react-lottie-player": "3.6.0",
    "@mailchimp/mailchimp_marketing": "3.0.80",
    "@supabase/supabase-js": "2.110.6",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@vercel/og": "0.11.1",
    "autoprefixer": "10.5.4",
    "date-fns": "4.4.0",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "image-size": "2.0.2",
    "markdown-it": "14.3.0",
    "markdown-to-text": "0.1.1",
    "marked": "18.0.6",
    "mdx-bundler": "10.1.1",
    "next": "16.2.10",
    "next-themes": "0.4.6",
    "node-html-parser": "9.0.0",
    "postcss": "8.5.19",
    "preact": "10.29.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown-renderer": "1.4.0",
    "react-qr-code": "2.2.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-citation": "2.3.2",
    "rehype-katex": "7.0.1",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-slug": "6.0.0",
    "remark-footnotes": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "rss": "1.2.2",
    "sanitize-html": "2.17.6",
    "sharp": "0.35.3",
    "smoothscroll-polyfill": "0.4.4",
    "string-similarity": "4.0.4",
    "tailwindcss": "4.3.2",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.10",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/github-slugger": "^2.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/smoothscroll-polyfill": "^0.3.4",
    "@types/string-similarity": "^4.0.2",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@vitejs/plugin-react": "5.2.0",
    "cross-env": "10.1.0",
    "dedent": "1.7.2",
    "dotenv": "17.4.2",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "file-loader": "6.2.0",
    "globby": "16.2.2",
    "husky": "9.1.7",
    "inquirer": "14.0.2",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "next-remote-watch": "2.0.0",
    "node-fetch": "3.3.2",
    "npm-check-updates": "22.2.9",
    "prettier": "3.9.5",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "^4.1.10",
    "xml2js": "0.6.2"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
