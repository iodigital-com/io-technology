{
  "name": "io-technology",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cross-env SOCKET=true node ./scripts/next-remote-watch.js ./data",
    "dev": "next dev",
    "build": "next build && node ./scripts/generate-sitemap && node ./scripts/generate-devto",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir pages --dir components --dir lib --dir layouts --dir scripts",
    "lint-staged": "lint-staged",
    "prepare": "husky install",
    "update:patch": "npm-check-updates --configFileName .ncurc.patch.cjs",
    "update:minor": "npm-check-updates --configFileName .ncurc.minor.cjs",
    "update:major": "npm-check-updates --configFileName .ncurc.major.cjs"
  },
  "engines": {
    "node": "~22",
    "npm": "~10"
  },
  "dependencies": {
    "@fontsource/inter": "4.5.15",
    "@lottiefiles/react-lottie-player": "3.6.0",
    "@mailchimp/mailchimp_marketing": "3.0.80",
    "@supabase/supabase-js": "2.47.12",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/typography": "0.5.16",
    "autoprefixer": "10.4.20",
    "date-fns": "3.6.0",
    "github-slugger": "1.5.0",
    "gray-matter": "4.0.3",
    "image-size": "1.2.0",
    "markdown-it": "13.0.2",
    "markdown-to-text": "0.1.1",
    "marked": "9",
    "mdx-bundler": "10.0.3",
    "next": "15.1.4",
    "next-themes": "0.4.4",
    "node-html-parser": "6.1.13",
    "postcss": "8.4.49",
    "preact": "10.25.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown-renderer": "1.4.0",
    "react-qr-code": "2.0.15",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "6.1.1",
    "rehype-citation": "0.5.0",
    "rehype-katex": "6.0.3",
    "rehype-preset-minify": "6.0.0",
    "rehype-prism-plus": "1.6.3",
    "rehype-slug": "5.1.0",
    "remark-footnotes": "4.0.1",
    "remark-gfm": "3.0.1",
    "remark-math": "5.1.1",
    "rss": "1.2.2",
    "sanitize-html": "2.14.0",
    "sharp": "0.33.5",
    "smoothscroll-polyfill": "0.4.4",
    "string-similarity": "4.0.4",
    "tailwindcss": "3.4.17",
    "unist-util-visit": "4.1.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "15.1.4",
    "@svgr/webpack": "6.5.1",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "cross-env": "7.0.3",
    "dedent": "0.7.0",
    "dotenv": "16.4.7",
    "eslint": "8.57.1",
    "eslint-config-next": "15.1.4",
    "eslint-config-prettier": "8.10.0",
    "eslint-plugin-prettier": "3.4.1",
    "file-loader": "6.2.0",
    "globby": "11.1.0",
    "husky": "6.0.0",
    "inquirer": "8.2.6",
    "lint-staged": "11.2.6",
    "next-remote-watch": "1.0.0",
    "node-fetch": "3.3.2",
    "npm-check-updates": "17.1.13",
    "prettier": "2.8.8",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "xml2js": "0.6.2"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
